APP_NAME=XCar
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://xcar.localhost:8010

APP_LOCALE=ru
APP_FALLBACK_LOCALE=ru
APP_FAKER_LOCALE=ru_RU

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=xcar_new
DB_USERNAME=xcar
DB_PASSWORD=xcar

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=.xcar.localhost

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

OCTANE_SERVER=frankenphp

# Хосты четырёх приложений: сайт — APP_URL, CRM, стоянка и гараж — поддомены
CRM_HOST=crm.xcar.localhost
PARK_HOST=park.xcar.localhost
GARAGE_HOST=garage.xcar.localhost

# Бот xcar в Telegram: владельцу и привязанным админам — кнопки решения, менеджерам — сделки и вход.
# chat_id бот подскажет сам в ответ на любое сообщение; имя бота можно не задавать — возьмётся у Telegram.
TELEGRAM_BOT_TOKEN=
TELEGRAM_OWNER_CHAT_ID=
TELEGRAM_BOT_USERNAME=

# Оплата по ссылке: ЮKassa, подключённая в СберБизнесе. Пусто — способа «Ссылкой» нет.
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=
# Признаки позиции чека — по согласованию с бухгалтером (vat_code: 1 без НДС, 4 — 20 %, 11 — 22 %).
YOOKASSA_VAT_CODE=1
YOOKASSA_VAT_CODE_WITH_VAT=4
YOOKASSA_PAYMENT_SUBJECT=commodity
YOOKASSA_PAYMENT_MODE=full_payment

# Выписка Sber API (СберБизнес). Сертификат клиента p12 и корневой «Russian Trusted Root CA» — файлами на сервере.
SBER_API_URL=https://fintech.sberbank.ru:9443
SBER_CLIENT_ID=
SBER_CLIENT_SECRET=
SBER_CERT=
SBER_CERT_PASSWORD=
SBER_CA=

# Ключ доступа (Face ID) один на три приложения: RP ID — родительский домен,
# он же покрывает все поддомены; origins пакет сравнивает по host'у, поэтому
# отдельный список не нужен. Локально — xcar.localhost (*.localhost — secure
# context). Пустое WEBAUTHN_ID= ломает регистрацию: либо значение, либо строки нет.
# В бою: WEBAUTHN_ID=xcar.ru
WEBAUTHN_NAME=XCar
WEBAUTHN_ID=xcar.localhost
