# Туннель прода xcar в Цюрих (README.md рядом). Держит его Цюрих: на проде
# 172.18.0.1 — шлюз сети compose — :9443 ведёт сюда и дальше к api.telegram.org:443
# (голая TCP-труба: TLS идёт от прода до Telegram, здесь не видно ни токенов, ни
# текстов), :9444 — к службе WhatsApp здесь (xcar-whatsapp, 127.0.0.1:9480). На диск
# туннель ничего не пишет. Пользователь xcar-tunnel на проде без оболочки, ему
# разрешено слушать только эти два адреса (deploy/server-setup.sh tunnel).
[Unit]
Description=xcar: туннель прода к Telegram и WhatsApp
After=network-online.target
# Перезапускать без конца: лёгший туннель видит check.sh на проде и пишет владельцу.
StartLimitIntervalSec=0

[Service]
ExecStart=/usr/bin/ssh -NT -i %h/.ssh/xcar_tunnel -o BatchMode=yes -o IdentitiesOnly=yes -o ExitOnForwardFailure=yes -o ServerAliveInterval=15 -o ServerAliveCountMax=3 -R 172.18.0.1:9443:api.telegram.org:443 -R 172.18.0.1:9444:127.0.0.1:9480 xcar-tunnel@200.169.180.17
Restart=always
RestartSec=5

[Install]
WantedBy=default.target
