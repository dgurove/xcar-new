# Настройки приложения. Лежит в /srv/xcar/env/.env.app, в git не попадает.
APP_NAME=XCar
APP_ENV=production
APP_KEY=
APP_DEBUG=false
# Хост сайта; CRM и стоянка — CRM_HOST и PARK_HOST ниже. До домена — имена nip.io.
APP_URL=http://200.169.180.17.nip.io
APP_LOCALE=ru
APP_FALLBACK_LOCALE=ru
APP_TIMEZONE=Europe/Moscow

LOG_CHANNEL=stderr
LOG_LEVEL=warning

DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=xcar
DB_USERNAME=xcar
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=43200
SESSION_SECURE_COOKIE=false
# Один вход на три хоста: точка в начале. В бою .xcar.ru
SESSION_DOMAIN=.200.169.180.17.nip.io
CACHE_STORE=database
QUEUE_CONNECTION=database
FILESYSTEM_DISK=local

OCTANE_SERVER=frankenphp

MAIL_MAILER=log

# В бою crm.xcar.ru и park.xcar.ru
CRM_HOST=crm.200.169.180.17.nip.io
PARK_HOST=park.200.169.180.17.nip.io
# Технические работы на стоянке: телефоны через запятую, кому открыта. Пусто — всем
PARK_ONLY=

# Родительский домен покрывает поддомены; ключи работают только по HTTPS.
WEBAUTHN_ID=xcar.ru

# Бот владельца в Telegram: регистрации с кнопками решения. chat_id бот подскажет сам в ответ на любое сообщение.
TELEGRAM_BOT_TOKEN=
TELEGRAM_OWNER_CHAT_ID=
