#!/usr/bin/env python3
# HEIC/HEIF с айфона → JPEG. Библиотечный libheif в Debian 12 (1.15) на снимках
# iOS 17+ падает «Metadata not correctly assigned», поэтому декодер — pillow-heif
# со своим libheif. Поворот из EXIF применяется, чтобы GD дальше не думал о нём.
import sys
from PIL import Image, ImageOps
import pillow_heif

pillow_heif.register_heif_opener()
src, dst = sys.argv[1], sys.argv[2]
image = ImageOps.exif_transpose(Image.open(src)).convert('RGB')
image.save(dst, 'JPEG', quality=92, optimize=True)
