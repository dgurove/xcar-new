#!/usr/bin/env python3
# OCR страниц и фото для «✨ Распознать» (`DocumentText`): PaddleOCR PP-OCRv5 через RapidOCR (ONNX, процессор) —
# детектор строк и русская модель eslav (кириллица с латиницей и цифрами: VIN, номер). Модели грузятся один раз на
# весь вызов, поэтому файлы передаются пачкой: `ocr page-1.png page-2.png photo.jpg`. На каждый файл — строка JSON
# {"file": путь, "text": текст} сразу, как прочитан: PHP показывает готовность по файлам, не дожидаясь пачки.
# Страница PDF (имя на «page-») и фото документа (имя на «doc-», паспорт) сначала ставятся прямо моделью ориентации —
# Альфа сканирует заявку боком, паспорт снимают как придётся; вышло меньше SHORT знаков — перебор остальных поворотов.
# Прочие фото — только по EXIF. Строка таблицы собирается из рамок по высоте: ячейки через три пробела, как ждёт `DocumentFields`.
# Скан паспорта (имя на «pass-») — как фото документа, и ещё два прохода поперёк (страница на ±90°): серия и
# номер напечатаны вертикально у края, вдоль их не прочитать. Из лучшего направления — только строки цифр, после строки
# «‹поперёк›» (`PassportText::ACROSS`). В JSON по файлу — `turn`: на сколько четвертей против часовой повернули страницу
# для лучшего текста (`ReadPassport` поворачивает сам файл).
# `ocr --angle page.png` — только угол страницы (0/90/180/270, против часовой): миниатюра скана в окне «✨» стоит
# прямо (`MailController::attachment`), модели OCR для этого не грузятся.
import faulthandler
import json
import os
import re
import sys

# Падение в C-коде (onnxruntime, OpenCV) — стек в stderr, его пишет лог PHP, а не голый «сигнал 11».
faulthandler.enable()

# onnxruntime 1.30 сам шлёт телеметрию Microsoft (mobile.events.data.microsoft.com): сканы чужих людей у нас, и
# наружу не должно уходить ничего. Её же HTTP-поток ронял процесс на выходе (SIGABRT в 1DS Events, 01.10.2026).
# Выключатель — до первого импорта onnxruntime (его тянет rapidocr), и ещё раз вызовом.
os.environ['ORT_DISABLE_TELEMETRY'] = '1'
import onnxruntime  # noqa: E402

onnxruntime.disable_telemetry_events()

import cv2  # noqa: E402
import numpy as np  # noqa: E402
import pillow_heif
from PIL import Image, ImageOps
from rapid_orientation import RapidOrientation
from rapidocr import EngineType, LangRec, ModelType, OCRVersion, RapidOCR

pillow_heif.register_heif_opener()
threads = int(os.environ.get('OCR_THREADS', '2'))
# OpenCV в один поток: его параллельный resize на ARM (KleidiCV) падал с SIGSEGV на гонке потоков; считает в
# основном onnxruntime, потоки OpenCV на наших картинках почти ничего не дают.
cv2.setNumThreads(1)

if sys.argv[1:2] == ['--angle']:
    image = np.asarray(ImageOps.exif_transpose(Image.open(sys.argv[2])).convert('RGB'))[:, :, ::-1]
    print(int(RapidOrientation()(np.ascontiguousarray(image))[0]))
    sys.exit(0)

engine = RapidOCR(params={
    'Global.log_level': 'error',
    'Global.use_cls': False,
    'Det.engine_type': EngineType.ONNXRUNTIME, 'Det.ocr_version': OCRVersion.PPOCRV5, 'Det.model_type': ModelType.MOBILE,
    'Rec.engine_type': EngineType.ONNXRUNTIME, 'Rec.ocr_version': OCRVersion.PPOCRV5, 'Rec.lang_type': LangRec.ESLAV, 'Rec.model_type': ModelType.MOBILE,
    'EngineConfig.onnxruntime.intra_op_num_threads': threads,
})
orientation = None


# Меньше знаков на странице — модель ориентации ошиблась (заявка Альфы боком читалась как «прямо»): перебрать
# остальные три поворота и взять тот, где текста больше. Платят только неудачные страницы.
SHORT = 150
SHORT_PASSPORT = 40


def load(path):
    """Картинка и угол модели ориентации (в четвертях оборота против часовой): у страницы PDF и у фото документа
    (имя на «doc-»: паспорт с телефона снимают и боком). Прочие фото — только по EXIF."""
    image = np.asarray(ImageOps.exif_transpose(Image.open(path)).convert('RGB'))[:, :, ::-1]
    if not os.path.basename(path).startswith(('page-', 'doc-', 'pass-')):
        return image, None
    if os.path.basename(path).startswith(('doc-', 'pass-')):
        image = document(image)
    global orientation
    orientation = orientation or RapidOrientation()
    return image, int(orientation(np.ascontiguousarray(image))[0]) // 90


def document(image):
    """Фото документа с телефона: мелкое — крупнее, строка паспорта в 1000 px нечитаема. Выравнивание контраста (CLAHE)
    пробовали на паспортах 11.10.2026 — цифры зоны читались хуже, не берём."""
    h, w = image.shape[:2]
    if max(h, w) < DOC_SIDE:
        k = DOC_SIDE / max(h, w)
        image = cv2.resize(np.ascontiguousarray(image), (int(w * k), int(h * k)), interpolation=cv2.INTER_CUBIC)
    return image


DOC_SIDE = 2200


def read(path):
    """Текст и поворот (четверти против часовой), с которым он прочитан."""
    image, turn = load(path)
    passport = os.path.basename(path).startswith('pass-')
    result = engine(np.ascontiguousarray(np.rot90(image, turn or 0)))
    text = '\n'.join(lines(result))
    best = turn or 0
    # Паспорт — порог ниже (21.11.2026: прописка от руки почти всегда короче 150 знаков, и каждая страница платила три лишних
    # прохода — 40 с на сервере, а модель ориентации на фото паспорта права; перебор — только совсем пустой странице).
    if turn is not None and len(text) < (SHORT_PASSPORT if passport else SHORT):
        # Модель ориентации меняется, только если текста явно больше (16.11.2026, прописка от руки боком: модель сказала
        # верно, а «прямо» дало на пару знаков больше такого же мусора — и страница осталась боком).
        mine = len(text)
        for k in (k for k in range(4) if k != turn):
            other_result = engine(np.ascontiguousarray(np.rot90(image, k)))
            other = '\n'.join(lines(other_result))
            if len(other) > max(len(text), mine * 1.5, mine + 50):
                text, best, result = other, k, other_result
    if passport:
        across_text = across(np.rot90(image, best), result)
        if across_text:
            text += '\n' + ACROSS + '\n' + across_text
    return text, best


ACROSS = '‹поперёк›'
ACROSS_SIDE = 2600


def across(image, result=None):
    """Цифры, напечатанные вертикально (серия и номер паспорта): страница на +90° и −90°; из направления, где больше
    шестизначных чисел (номер), — только строки с четырьмя и больше цифрами, цифрами через пробел. Ужимать нельзя:
    на 1600 px красные цифры не находились (скан 07.11.2026). Читается не вся страница, а полоса справа от строк текста
    (`edge`): номер напечатан у правого края бланка — два прохода по полосе вместо двух по странице (21.11.2026)."""
    image = image[:, edge(image, result):]
    h, w = image.shape[:2]
    if max(h, w) > ACROSS_SIDE:
        k = ACROSS_SIDE / max(h, w)
        image = cv2.resize(np.ascontiguousarray(image), (int(w * k), int(h * k)), interpolation=cv2.INTER_AREA)
    best, most = [], 0
    for k in (1, 3):
        found = []
        for line in lines(engine(np.ascontiguousarray(np.rot90(image, k)))):
            # Не цифра — пробел: «050-003» и «19.09.1982» не склеиваются в шестизначные.
            digits = ' '.join(re.sub(r'[^\d]', ' ', line.replace('O', '0').replace('О', '0')).split())
            if sum(c.isdigit() for c in digits) >= 4:
                found.append(digits)
        six = sum(len(re.findall(r'(?<!\d)\d{6}(?!\d)', line)) for line in found)
        if six > most:
            best, most = found, six
    return '\n'.join(best)


def edge(image, result):
    """Левый край полосы для поперечных проходов: правее строк, прочитанных вдоль (рамки вдвое шире своей высоты), с запасом
    6 % ширины; не правее 85 % — полоса не уже 15 %. Строк нет — вся страница. На девяти паспортах 20–21.11.2026 номер из
    полосы — тот же, что со всей страницы."""
    if result is None or result.boxes is None:
        return 0
    w = image.shape[1]
    right = [max(p[0] for p in b) for b in result.boxes if max(p[0] for p in b) - min(p[0] for p in b) > 2 * (max(p[1] for p in b) - min(p[1] for p in b))]
    return int(max(0, min(max(right) - 0.06 * w, 0.85 * w))) if right else 0


def lines(result):
    if result.boxes is None:
        return []
    # Фото с наклоном: строка уходит вверх или вниз, и по голой высоте рамки соседние строки перемешивались (машиночитаемая
    # зона паспорта шла вперемешку). Высота считается вдоль общего наклона — медиана наклона длинных рамок.
    slopes = sorted((b[1][1] - b[0][1]) / (b[1][0] - b[0][0]) for b in result.boxes if b[1][0] - b[0][0] > 2 * abs(b[3][1] - b[0][1]) > 0)
    slope = slopes[len(slopes) // 2] if slopes else 0.0
    items = []
    for box, text in zip(result.boxes, result.txts):
        xs = [p[0] for p in box]
        ys = [p[1] - slope * p[0] for p in box]
        items.append({'x0': min(xs), 'x1': max(xs), 'y': (min(ys) + max(ys)) / 2, 'h': max(ys) - min(ys), 't': text})
    items.sort(key=lambda i: i['y'])
    rows = []
    for item in items:
        row = rows[-1] if rows else None
        if row and abs(item['y'] - row['y']) < 0.5 * min(item['h'], row['h']):
            row['items'].append(item)
            row['y'] = sum(i['y'] for i in row['items']) / len(row['items'])
        else:
            rows.append({'y': item['y'], 'h': item['h'], 'items': [item]})
    out = []
    for row in rows:
        row['items'].sort(key=lambda i: i['x0'])
        text, prev = '', None
        for item in row['items']:
            if prev:
                char = (prev['x1'] - prev['x0']) / max(len(prev['t']), 1)
                text += '   ' if item['x0'] - prev['x1'] > 1.5 * char else ' '
            text += item['t']
            prev = item
        out.append(text)
    return out


for path in sys.argv[1:]:
    try:
        text, turn = read(path)
    except Exception as e:  # битый файл — пустой текст, пачка идёт дальше
        print(f'ocr: {path}: {e}', file=sys.stderr)
        text, turn = '', 0
    print(json.dumps({'file': path, 'text': text, 'turn': turn}, ensure_ascii=False), flush=True)
