# Граница и сервер приложения — один процесс FrankenPHP под Laravel Octane.
# Переменные CADDY_SERVER_* и APP_PUBLIC_PATH выставляет `octane:frankenphp`,
# остальные приходят из compose.
{
	email {$ACME_EMAIL:proverka@example.com}
	admin {$CADDY_SERVER_ADMIN_HOST}:{$CADDY_SERVER_ADMIN_PORT}

	# Пусто в бою. `local_certs` — самоподписанные сертификаты для проверки
	# стека, когда ACME пройти нельзя.
	{$CADDY_GLOBAL_EXTRA}

	log {
		output stderr
		format json
	}

	servers {
		trusted_proxies static private_ranges
	}

	# Воркеров по умолчанию четыре (два на ядро), и четыре медленных ответа — PDF или каталог телефону по слабой сети —
	# занимали их все: остальные ждали в очереди, а таймер в 30 с у них шёл уже на работе (16.10.2026, таймауты /offers
	# в пик импорта Мигторга). Под нагрузкой воркеров до восьми; ждать свободного — не дольше 15 с, дальше 504, а не
	# висящий запрос. Скрипты ждут ответа 50 с: 15 очереди и 30 работы (`net.js`, `lib/http.js`).
	frankenphp {
		max_threads 10
		max_wait_time 15s
		worker {
			file "{$APP_PUBLIC_PATH}/frankenphp-worker.php"
			{$CADDY_SERVER_WORKER_DIRECTIVE}
			max_threads 8
		}
	}
}

(common) {
	log {
		output stderr
		# Токен Mercure приезжает в строке запроса — в журнал не пускаем.
		format filter {
			request>uri query {
				replace authorization ВЫРЕЗАНО
			}
		}
	}

	encode zstd br gzip

	header {
		-Server
		X-Content-Type-Options nosniff
		X-Frame-Options SAMEORIGIN
		Referrer-Policy strict-origin-when-cross-origin
	}
}

(app) {
	root * {$APP_PUBLIC_PATH}

	# Медиатека с диска, мимо PHP.
	handle_path /media/* {
		root * /app/storage/app/media
		file_server
		header Cache-Control "public, max-age=2592000"
	}

	# Сжатые версии и кадры кандидатов — с быстрого диска.
	handle_path /hot/* {
		root * /app/storage/app/hot
		file_server
		header Cache-Control "public, max-age=2592000"
	}

	# Сборка сжата заранее (scripts/precompress.mjs при сборке образа) — отдаём готовые .br/.gz, а не жмём на лету.
	handle /build/* {
		header Cache-Control "public, max-age=31536000, immutable"
		file_server {
			precompressed br gzip
		}
	}

	# Шрифт — месяц; картинки и значки приложения без хэша в имени (логотип меняли на месте) — сутки,
	# дальше браузер показывает сохранённое и сверяется в фоне. Раньше заголовка не было вовсе.
	handle /fonts/* {
		header Cache-Control "public, max-age=2592000"
		file_server
	}
	handle /images/* {
		header Cache-Control "public, max-age=86400, stale-while-revalidate=604800"
		file_server
	}
	handle /pwa/* {
		header Cache-Control "public, max-age=86400, stale-while-revalidate=604800"
		file_server
	}

	# Готовые PDF и фото «Поделиться» отдаёт Caddy, а не PHP (17.10.2026: 3–4 МБ телефону по слабой сети качались дольше
	# 30 с, воркер падал «Maximum execution time»). PHP отвечает пустым телом с `X-Accel-Redirect: /offers/142/….pdf` —
	# путь внутри кэша share (`ShareController::send`), заголовки ответа остаются его. Снаружи этот каталог не открыт:
	# подмена срабатывает только по заголовку ответа приложения. `X-Share-Sendfile` говорит приложению, что Caddy здесь.
	request_header X-Share-Sendfile 1
	intercept {
		@share header X-Accel-Redirect *
		handle_response @share {
			root * /app/storage/app/cache/share
			rewrite * {resp.header.X-Accel-Redirect}
			method * GET
			header -X-Accel-Redirect
			file_server
		}
	}

	php_server {
		index frankenphp-worker.php
		try_files {path} frankenphp-worker.php
		resolve_root_symlink
	}
}

# Проверка живости только изнутри контейнера: ответ даёт php, не сервер.
http://127.0.0.1:2020 {
	import app
}

# Все имена сайта одним блоком: приложение само разбирает хост.
# Пока домена нет — `http://<ip>` и имена nip.io; в бою — `xcar.ru, crm.xcar.ru, park.xcar.ru, garage.xcar.ru`
# (garage — прежний хост гаража: приложение отвечает 301 на xcar.ru/garage, имя держим ради сертификата).
# `http://app` — внутреннее имя, по нему очередь публикует в хаб.
{$SITE_ADDRESSES:http://localhost}, http://app {
	import common

	# Хаб живых обновлений. Приложение публикует всё только с `private=on`:
	# список тем в токене подписчика ограничивает доставку, а не подписку.
	mercure {
		publisher_jwt {$MERCURE_PUBLISHER_KEY}
		subscriber_jwt {$MERCURE_SUBSCRIBER_KEY}
	}

	import app
}

# Прежние имена и голый IP уводим на основное имя: на голом IP cookie с
# SESSION_DOMAIN не принимаются — вход не держится. Схема — http, пока нет домена.
{$REDIRECT_ADDRESSES:http://redirect.localhost} {
	import common
	redir {$REDIRECT_SCHEME:https}://{$REDIRECT_TO:localhost}{uri} permanent
}
